# Database — never commit the live DB (40 MB, contains personal trade data)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# ...with one deliberate exception: the CI boot-test fixture. It is a slice of
# the schema plus public market data only — every table holding personal data
# (trades, portfolio capital, agent chat/reports) is emptied by
# tests/fixtures/build_fixture_db.py before it is written. See
# docs/DEPLOYMENT.md. Do not add other .db files here.
!tests/fixtures/psx_fixture.db

# Transient / editor / probe files
.fuse_hidden*
*.tmp
test_*.bin

# Local virtualenvs -- never commit an interpreter/site-packages tree
.venv/
.venv_check/
venv/
env/

# Secrets
.env
secrets.toml
.streamlit/secrets.toml
notes/
*key*.txt
*.key

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Logs
*.log
streamlit.log

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/

# Exports (generated files)
exports/

# Trained ML models (large binaries — downloaded at runtime or from CI artifacts)
*.pkl

# Migration script output
migrate_to_supabase.log
features_dataset.csv
support_signals_20260521_130920.csv

# Large regenerable data exports — exceed/near GitHub's per-file size limits
open_acquisition_output/open_prices_stocks.csv
boring_study/boring_donchian_mechanism_dataset.csv

# Scratch/working dirs from audit & repair sessions — never commit
# (some contain full DB exports, incl. personal trade data)
scratch_*/

# Local backup artifacts (the .db files are already covered by *.db above;
# this also covers checksums and manifests alongside them)
backups/

# Generated locally, not read by the deployed dashboard:
#   market_breadth_oscillator.png — written by market_breadth_oscillator.py, displayed nowhere
#   twitter_output/*               — written by content_generator.py (local social tool)
# NOTE: breadth_data.csv is deliberately NOT ignored — dashboard.py reads it at runtime.
market_breadth_oscillator.png
twitter_output/

# Internal production-trust control document — kept local by standing decision.
# Never been in the repo. To publish it is a separate, deliberate call (use `git add -f`).
docs/KIRAN_BORING_STATE_TRUST_REGISTER.md
